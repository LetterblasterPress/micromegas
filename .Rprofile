suppressMessages(require(devtools))

use_import_from <- function(...) {
  write("RoxygenNote: 8.1.0", "DESCRIPTION", append = TRUE)
  usethis::use_import_from(...)
  usethis::use_tidy_description()
}

use_package <- function(...) {
  write("RoxygenNote: 8.1.0", "DESCRIPTION", append = TRUE)
  usethis::use_package(...)
  usethis::use_tidy_description()
}

load_all()
