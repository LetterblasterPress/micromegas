> This notebook identifies proper nouns that appear in Micromégas frequently
> enough to warrant custom hyphenation rules.

```{r setup, include = FALSE}
knitr::opts_chunk$set(collapse = TRUE, comment = "#>")

library(micromegas)
library(tidyverse)
```

```{r, echo = FALSE}
source_text() |>
  strsplit("[^A-Za-z-]+") |>
  unlist() |>
  tibble() |>
  set_names("word") |>
  summarise(word_count = n(), .by = "word") |>
  group_by(token = tolower(word)) |>
  mutate(token_count = sum(word_count)) |>
  ungroup() |>
  mutate(freq_ntile = 100 * percent_rank(token_count)) |>
  filter(
    freq_ntile > 90,
    grepl("^[A-Z]", word),
    !grepl("^[A-Z-]+$", word),
    !tolower(word) %in% word
  ) |>
  arrange(desc(freq_ntile)) |>
  select(` ` = word, percentile = freq_ntile) |>
  knitr::kable(caption = "Frequency of common proper nouns", digits = 1)
```
